# Copy to .env and adjust. Never put real passwords or secrets in this file.

# --- Server ---
HOST=127.0.0.1
PORT=5000
# Keep debug OFF: the debugger can show request data in tracebacks.
FLASK_DEBUG=false

# --- Input limits ---
MAX_PASSWORD_LENGTH=256

# --- Optional analytics (metadata only, never passwords) ---
ANALYTICS_ENABLED=true
ANALYTICS_DB_PATH=instance/analytics.db

# --- Rate limiting (requests per minute per client IP) ---
RATE_LIMIT_ENABLED=true
ANALYZE_RATE_LIMIT_PER_MINUTE=240
GENERATE_RATE_LIMIT_PER_MINUTE=60

# --- Administrator password policy (reported separately from strength) ---
POLICY_MIN_LENGTH=12
POLICY_MAX_LENGTH=128
POLICY_COMMON_PASSWORD_CHECK=true
POLICY_PERSONAL_INFO_CHECK=true
POLICY_ALLOW_SPACES=true

# --- Optional custom word lists ---
# COMMON_PASSWORDS_FILE=data/common_passwords.txt
# COMMON_WORDS_FILE=data/common_words.txt
# PASSPHRASE_WORDLIST=data/passphrase_words.txt
